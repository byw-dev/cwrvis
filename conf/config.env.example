# cwrvis 环境变量配置
# 复制本文件为 config.env 并按需修改，start.sh 启动时自动加载

PORT=8000

# 信任的上游反向代理 IP，多个用逗号分隔，"*" 表示信任所有（仅限封闭内网）
# 示例：FORWARDED_ALLOW_IPS=192.168.1.10
# 未设置时默认只信任 127.0.0.1（直连场景）
FORWARDED_ALLOW_IPS=

# 以下路径均相对于 app/ 目录（即 backend/ 的部署位置），也可写绝对路径
#
# 实际生效的只有三项：
#   DB_PATH      —— database.py 读取
#   STATIC_ROOT  —— main.py 据此挂载 /grid、/shapes、/（前端）
#   REPORT_DIR   —— routers/report.py 读取
DB_PATH=../db/stats.db
STATIC_ROOT=../static
REPORT_DIR=../static/reports

# GRID_DIR / SHAPES_DIR 为历史遗留，后端代码并不读取（格点与区域 GeoJSON 一律
# 由 STATIC_ROOT/grid、STATIC_ROOT/shapes 提供）。保留仅为兼容既有部署的配置文件。
GRID_DIR=../static/grid
# 专题图目录（外部管理，不含于发布包，部署后需单独同步）
# 示例：IMAGE_DIR=/data/cwrvis/images-xz
